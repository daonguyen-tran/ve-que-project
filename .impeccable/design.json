  "narrative": {
    "northStar": "Billets en đồng",
    "overview": "Un outil de terrain dont l'identité tient en une coque rouge laque, des surfaces blanches et un montant lisible comme la valeur faciale d'un billet. Les couleurs des billets codent les catégories de dépenses ; le curcuma marque uniquement le maintenant.",
    "keyCharacteristics": [
      "Coque rouge laque",
      "Montant valeur faciale",
      "Catégories aux couleurs des billets",
      "Curcuma réservé au maintenant",
      "Be Vietnam Pro, chiffres tabulaires"
    ],
    "rules": [
      {
        "name": "La règle du maintenant",
        "body": "Le curcuma ne marque que ce qui se passe en ce moment.",
        "section": "colors"
      },
      {
        "name": "Jamais la couleur seule",
        "body": "Un dépassement s'annonce par une icône et une phrase.",
        "section": "colors"
      },
      {
        "name": "Milliers lisibles",
        "body": "En grand corps, espace insécable normale entre les groupes de chiffres.",
        "section": "typography"
      },
      {
        "name": "Une seule élévation",
        "body": "Seule la carte qui chevauche le bandeau et le bouton flottant portent une ombre.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Afficher chaque montant avec sa devise et ses séparateurs.",
      "Écrire des états vides qui disent quoi faire."
    ],
    "donts": [
      "Utiliser le curcuma pour décorer.",
      "Imiter le décor d'un billet (guillochis, filigrane).",
      "Ajouter surtitres, dégradés, verre dépoli ou emojis."
    ]
  }
